#pragma once

// Homebrew's x86_64-elf-gcc ships no libstdc++ at all (not even the
// freestanding-mandatory headers), so this project provides its own for
// the handful of names actually used. GCC always predefines these __*_TYPE__
// macros from its target description, in or out of freestanding mode —
// that's what real <cstdint> implementations build on too.
namespace std {

using int8_t = __INT8_TYPE__;
using int16_t = __INT16_TYPE__;
using int32_t = __INT32_TYPE__;
using int64_t = __INT64_TYPE__;

using uint8_t = __UINT8_TYPE__;
using uint16_t = __UINT16_TYPE__;
using uint32_t = __UINT32_TYPE__;
using uint64_t = __UINT64_TYPE__;

using intptr_t = __INTPTR_TYPE__;
using uintptr_t = __UINTPTR_TYPE__;

} // namespace std

using std::int16_t;
using std::int32_t;
using std::int64_t;
using std::int8_t;
using std::intptr_t;
using std::uint16_t;
using std::uint32_t;
using std::uint64_t;
using std::uint8_t;
using std::uintptr_t;
